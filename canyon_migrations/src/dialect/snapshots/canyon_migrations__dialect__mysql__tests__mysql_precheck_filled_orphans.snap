---
source: canyon_migrations/src/dialect/mysql.rs
expression: show(&st)
---
SELECT CAST(EXISTS (SELECT 1 FROM `player` AS canyon_c WHERE canyon_c.`season` IS NOT NULL AND NOT EXISTS (SELECT 1 FROM `league` AS canyon_p WHERE canyon_p.`season` = canyon_c.`season` AND canyon_p.`division` = COALESCE(canyon_c.`division`, ?) AND canyon_p.`id` = ?)) AS SIGNED)
  params: [Text("a"), BigInt(7)]
  transactional: true
